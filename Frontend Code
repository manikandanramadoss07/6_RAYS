<style>

/* =====================================================
   COLOR VARIABLES
===================================================== */

:root{

    --blue:#0878c9;
    --blue-dark:#04558f;
    --blue-light:#eaf6ff;

    --green:#18a66a;
    --green-light:#e8f8f0;

    --red:#dc4545;
    --orange:#e49a17;

    --bg:#f3f8fc;
    --card:#ffffff;
    --card2:#f8fbfd;

    --text:#17384f;
    --muted:#657d8d;

    --border:#c5d8e3;

    --shadow:
        0 8px 25px rgba(30,90,130,.10);
}


/* =====================================================
   DARK MODE
===================================================== */

body.dark{

    --blue:#63c7ff;
    --blue-dark:#279edc;
    --blue-light:#173b50;

    --green:#54dfa2;
    --green-light:#173c30;

    --bg:#091118;
    --card:#111e27;
    --card2:#172933;

    --text:#ffffff;
    --muted:#c4d3dc;

    --border:#ffffff;

    --shadow:
        0 10px 30px rgba(0,0,0,.45);
}


/* =====================================================
   GLOBAL
===================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{

    font-family:
    "Segoe UI",
    Arial,
    sans-serif;

    background:var(--bg);

    color:var(--text);

    transition:.3s;
}

button,
input{
    font-family:inherit;
}


/* =====================================================
   THEME BUTTON
===================================================== */

.theme-button{

    position:fixed;

    right:25px;
    top:20px;

    width:46px;
    height:46px;

    border-radius:50%;

    border:2px solid var(--border);

    background:var(--card);

    color:var(--text);

    cursor:pointer;

    font-size:20px;

    z-index:2000;
}


/* =====================================================
   LOGIN PAGE
===================================================== */

.login-page{

    min-height:100vh;

    display:flex;

    justify-content:center;

    align-items:center;

    padding:25px;
}


.login-box{

    width:100%;
    max-width:950px;

    display:grid;

    grid-template-columns:45% 55%;

    background:var(--card);

    border:2px solid var(--border);

    border-radius:25px;

    overflow:hidden;

    box-shadow:var(--shadow);
}


/* =====================================================
   LOGIN BRANDING
===================================================== */

.login-blue{

    padding:60px;

    display:flex;

    justify-content:center;

    flex-direction:column;

    color:white;

    background:
    linear-gradient(
        145deg,
        #034d86,
        #087bc9
    );
}


.login-blue h1{

    font-size:42px;

    margin-bottom:15px;

    letter-spacing:.5px;
}


.login-blue h1 span{

    color:#9ce2ff;
}


.login-blue p{

    font-size:17px;

    color:#e8f7ff;

    line-height:1.7;
}


/* =====================================================
   LOGIN FORM
===================================================== */

.login-form{

    padding:55px;
}


.login-form h2{

    text-align:center;

    color:var(--blue);

    margin-bottom:28px;

    font-size:27px;
}


/* =====================================================
   ROLE BUTTONS
===================================================== */

.roles{

    display:grid;

    grid-template-columns:
    repeat(3,1fr);

    gap:10px;

    margin-bottom:25px;
}


.role{

    border:2px solid var(--border);

    background:var(--card2);

    color:var(--text);

    border-radius:12px;

    padding:13px 5px;

    cursor:pointer;

    font-weight:700;

    transition:.2s;
}


.role:hover{

    border-color:var(--blue);
}


.role.active{

    background:var(--blue);

    color:white;

    border-color:var(--blue);
}


/* =====================================================
   INPUTS
===================================================== */

.input{

    margin-bottom:18px;
}


.input label{

    display:block;

    font-weight:700;

    margin-bottom:7px;
}


.input input{

    width:100%;

    height:50px;

    padding:0 14px;

    border-radius:10px;

    border:2px solid var(--border);

    background:var(--card2);

    color:var(--text);

    outline:none;
}


.input input:focus{

    border-color:var(--blue);
}


/* =====================================================
   LOGIN BUTTON
===================================================== */

.login-button{

    width:100%;

    height:52px;

    border:0;

    border-radius:10px;

    background:var(--blue);

    color:white;

    font-size:16px;

    font-weight:800;

    cursor:pointer;
}


.login-button:hover{

    opacity:.9;
}


/* =====================================================
   DASHBOARD
===================================================== */

.dashboard{

    display:none;

    min-height:100vh;
}


/* =====================================================
   SIDEBAR
===================================================== */

.sidebar{

    position:fixed;

    top:0;
    left:0;
    bottom:0;

    width:255px;

    padding:25px 16px;

    background:
    linear-gradient(
        180deg,
        #034f89,
        #087bc9
    );

    color:white;
}


.logo{

    font-size:27px;

    font-weight:900;

    padding:10px;

    margin-bottom:30px;
}


.user-box{

    background:
    rgba(255,255,255,.14);

    border-radius:12px;

    padding:15px;

    margin-bottom:25px;
}


.user-box small{

    opacity:.75;
}


.user-box strong{

    display:block;

    margin-top:5px;
}


/* =====================================================
   NAVIGATION
===================================================== */

.nav{

    padding:13px;

    margin:6px 0;

    border-radius:10px;

    cursor:pointer;

    transition:.2s;
}


.nav:hover{

    background:
    rgba(255,255,255,.18);
}


.nav.active{

    background:
    rgba(255,255,255,.25);
}


.logout{

    position:absolute;

    left:16px;
    right:16px;
    bottom:22px;

    padding:13px;

    text-align:center;

    border-radius:10px;

    background:#c83b3b;

    cursor:pointer;
}


/* =====================================================
   MAIN
===================================================== */

.main{

    margin-left:255px;

    padding:30px;
}


/* =====================================================
   TOP BAR
===================================================== */

.topbar{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:25px;
}


.topbar h1{

    color:var(--blue);

    font-size:29px;
}


.topbar p{

    color:var(--muted);

    margin-top:5px;
}


.profile{

    padding:12px 17px;

    border:2px solid var(--border);

    background:var(--card);

    border-radius:12px;
}


/* =====================================================
   STAT CARDS
===================================================== */

.stats{

    display:grid;

    grid-template-columns:
    repeat(4,1fr);

    gap:17px;

    margin-bottom:22px;
}


.stat{

    background:var(--card);

    border:2px solid var(--border);

    border-radius:15px;

    padding:20px;

    cursor:pointer;

    box-shadow:var(--shadow);

    transition:.2s;
}


.stat:hover{

    transform:translateY(-3px);

    border-color:var(--blue);
}


.stat small{

    color:var(--muted);
}


.stat h2{

    color:var(--blue);

    margin-top:7px;
}


/* =====================================================
   CONTENT
===================================================== */

.content{

    display:grid;

    grid-template-columns:
    2fr 1fr;

    gap:20px;
}


.panel{

    background:var(--card);

    border:2px solid var(--border);

    border-radius:17px;

    padding:23px;

    margin-bottom:20px;

    box-shadow:var(--shadow);
}


.panel-title{

    color:var(--blue);

    margin-bottom:20px;

    font-size:20px;
}


/* =====================================================
   PATIENT DETAILS
===================================================== */

.patient-details{

    display:grid;

    grid-template-columns:
    repeat(3,1fr);

    gap:13px;
}


.detail{

    padding:15px;

    background:var(--card2);

    border:2px solid var(--border);

    border-radius:10px;

    cursor:pointer;
}


.detail:hover{

    border-color:var(--blue);
}


.detail small{

    color:var(--muted);
}


.detail strong{

    display:block;

    margin-top:5px;
}


.normal{

    color:var(--green)!important;
}


/* =====================================================
   BIOMEDICAL PARAMETERS
===================================================== */

.parameters{

    display:grid;

    grid-template-columns:
    repeat(4,1fr);

    gap:15px;
}


.parameter{

    min-height:145px;

    display:flex;

    flex-direction:column;

    align-items:center;

    justify-content:center;

    text-align:center;

    padding:15px;

    border-radius:14px;

    background:var(--card2);

    border:2px solid var(--border);

    cursor:pointer;

    transition:.2s;
}


.parameter:hover{

    transform:translateY(-3px);

    border-color:var(--blue);
}


.parameter-icon{

    font-size:30px;
}


.parameter h3{

    color:var(--blue);

    margin:7px 0 3px;

    font-size:21px;
}


.parameter small{

    color:var(--muted);
}


.parameter-status{

    margin-top:8px;

    padding:4px 9px;

    border-radius:20px;

    background:var(--green-light);

    color:var(--green);

    font-size:11px;

    font-weight:800;
}


/* DARK MODE PARAMETERS */

body.dark .parameter{

    background:#172933;

    border:2px solid #ffffff;
}


body.dark .parameter h3{

    color:#ffffff;
}


body.dark .parameter small{

    color:#d5e2e9;
}


/* =====================================================
   EDIT BUTTON
===================================================== */

.edit-button{

    margin-top:18px;

    padding:11px 18px;

    border:0;

    border-radius:9px;

    background:var(--blue);

    color:white;

    font-weight:700;

    cursor:pointer;
}


/* =====================================================
   REPORTS
===================================================== */

.report{

    padding:17px;

    border:2px solid var(--border);

    border-left:6px solid var(--green);

    border-radius:10px;

    background:var(--card2);

    cursor:pointer;
}


.report h4{

    color:var(--blue);

    margin-bottom:7px;
}


.report p{

    color:var(--muted);

    line-height:1.6;
}


/* =====================================================
   INSTRUMENTS
===================================================== */

.instrument{

    display:flex;

    align-items:center;

    gap:13px;

    padding:14px;

    margin-bottom:12px;

    border:2px solid var(--border);

    background:var(--card2);

    border-radius:12px;

    cursor:pointer;
}


.instrument:hover{

    border-color:var(--blue);
}


.instrument img{

    width:60px;

    height:60px;

    object-fit:contain;
}


.instrument small{

    display:block;

    color:var(--muted);

    margin-top:4px;
}


/* =====================================================
   RISK SCORE
===================================================== */

.risk{

    display:none;
}


.risk-card{

    text-align:center;

    padding:25px;

    border:2px solid var(--red);

    border-radius:14px;

    background:
    rgba(220,69,69,.07);
}


.risk-number{

    font-size:48px;

    font-weight:900;

    color:var(--red);
}


.risk-label{

    color:var(--red);

    font-weight:900;
}


/* =====================================================
   ACCESS
===================================================== */

.access{

    padding:16px;

    border:2px solid var(--green);

    border-radius:11px;

    background:var(--green-light);

    color:var(--text);

    line-height:1.7;
}


/* =====================================================
   MODAL
===================================================== */

.modal{

    display:none;

    position:fixed;

    inset:0;

    background:
    rgba(0,0,0,.55);

    z-index:3000;

    align-items:center;

    justify-content:center;

    padding:20px;
}


.modal-box{

    width:100%;

    max-width:600px;

    max-height:90vh;

    overflow:auto;

    background:var(--card);

    border:2px solid var(--border);

    border-radius:18px;

    padding:25px;
}


.modal-box h2{

    color:var(--blue);

    margin-bottom:20px;
}


.edit-grid{

    display:grid;

    grid-template-columns:
    1fr 1fr;

    gap:15px;
}


.modal-buttons{

    display:flex;

    gap:10px;

    margin-top:20px;
}


.save{

    flex:1;

    padding:12px;

    border:0;

    border-radius:9px;

    background:var(--green);

    color:white;

    font-weight:800;

    cursor:pointer;
}


.cancel{

    flex:1;

    padding:12px;

    border:0;

    border-radius:9px;

    background:#777;

    color:white;

    cursor:pointer;
}


/* =====================================================
   RESPONSIVE
===================================================== */

@media(max-width:1100px){

    .parameters{

        grid-template-columns:
        repeat(3,1fr);
    }

    .stats{

        grid-template-columns:
        repeat(2,1fr);
    }
}


@media(max-width:850px){

    .login-box{

        grid-template-columns:1fr;
    }

    .login-blue{

        display:none;
    }

    .content{

        grid-template-columns:1fr;
    }

    .sidebar{

        position:relative;

        width:100%;

        height:auto;
    }

    .logout{

        position:relative;

        left:auto;
        right:auto;
        bottom:auto;

        margin-top:20px;
    }

    .main{

        margin-left:0;
    }
}


@media(max-width:600px){

    .main{

        padding:15px;
    }

    .patient-details{

        grid-template-columns:
        1fr 1fr;
    }

    .parameters{

        grid-template-columns:
        1fr 1fr;
    }

    .stats{

        grid-template-columns:1fr;
    }

    .roles{

        grid-template-columns:1fr;
    }

    .edit-grid{

        grid-template-columns:1fr;
    }
}

</style>

