<script>

/* =====================================================
                    LOGIN DATA
===================================================== */

let currentRole="doctor";


const doctors=[

{
username:"doctor01",
password:"Doc@123"
}

];


const surveyors=[

{
username:"survey01",
password:"Survey@123"
}

];


const patients=[

{
phone:"9876543210",
name:"Arun Kumar"
},

{
phone:"9876543211",
name:"Priya S"
}

];


/* =====================================================
                    THEME
===================================================== */

function toggleTheme(){

document.body.classList.toggle("dark");

const button=
document.getElementById("themeButton");


if(
document.body.classList.contains("dark")
){

button.innerText="☀️";

localStorage.setItem(
"theme",
"dark"
);

}

else{

button.innerText="🌙";

localStorage.setItem(
"theme",
"light"
);

}

}


if(
localStorage.getItem("theme")
==="dark"
){

document.body.classList.add("dark");

document.getElementById(
"themeButton"
).innerText="☀️";

}


/* =====================================================
                    ROLE SELECTION
===================================================== */

function selectRole(role,button){

currentRole=role;


document
.querySelectorAll(".role")
.forEach(
x=>x.classList.remove("active")
);


button.classList.add("active");


const username=
document.getElementById("usernameBox");

const password=
document.getElementById("passwordBox");

const phone=
document.getElementById("phoneBox");

const loginButton=
document.getElementById("loginButton");


if(role==="patient"){

username.style.display="none";

password.style.display="none";

phone.style.display="block";

loginButton.innerText=
"View My Health Details";

}

else{

username.style.display="block";

password.style.display="block";

phone.style.display="none";


loginButton.innerText=
role==="doctor"
?
"Login as Doctor"
:
"Login as Surveyor";

}

}


/* =====================================================
                        LOGIN
===================================================== */

function login(){

if(currentRole==="doctor"){

const username=
document.getElementById(
"username"
).value.trim();

const password=
document.getElementById(
"password"
).value;


const valid=
doctors.some(
x=>
x.username===username &&
x.password===password
);


if(!valid){

alert(
"Access Denied: Invalid Doctor credentials."
);

return;

}


openDashboard(
"doctor",
"Doctor"
);

}


else if(currentRole==="surveyor"){

const username=
document.getElementById(
"username"
).value.trim();

const password=
document.getElementById(
"password"
).value;


const valid=
surveyors.some(
x=>
x.username===username &&
x.password===password
);


if(!valid){

alert(
"Access Denied: Invalid Surveyor credentials."
);

return;

}


openDashboard(
"surveyor",
"Medical Surveyor"
);

}


else{

const phone=
document.getElementById(
"phone"
).value.trim();


const patient=
patients.find(
x=>x.phone===phone
);


if(!patient){

alert(
"Patient not found."
);

return;

}


openDashboard(
"patient",
patient.name
);

}

}


/* =====================================================
                OPEN DASHBOARD
===================================================== */

function openDashboard(role,name){

document.getElementById(
"loginPage"
).style.display="none";


document.getElementById(
"dashboard"
).style.display="block";


currentRole=role;


configureDashboard(name);

}


/* =====================================================
                ACCESS CONFIGURATION
===================================================== */

function configureDashboard(name){

const title=
document.getElementById(
"dashboardTitle"
);

const role=
document.getElementById(
"loggedRole"
);

const profile=
document.getElementById(
"profileName"
);

const risk=
document.getElementById(
"riskSection"
);

const riskNav=
document.getElementById(
"riskNav"
);

const editPatient=
document.getElementById(
"editPatient"
);

const editParameters=
document.getElementById(
"editParameters"
);

const access=
document.getElementById(
"accessText"
);


if(currentRole==="doctor"){

title.innerText=
"Doctor Dashboard";

role.innerText=
"Doctor";

profile.innerText=
"Doctor";

risk.style.display="block";

riskNav.style.display="block";

editPatient.style.display=
"inline-block";

editParameters.style.display=
"inline-block";


access.innerHTML=`

<strong style="color:var(--green)">
● Full Access
</strong>

<br><br>

Patient details:
<strong>Editable</strong>

<br>

Biomedical parameters:
<strong>Editable</strong>

<br>

Medical reports:
<strong>Editable</strong>

<br>

Risk score:
<strong>Visible</strong>

`;

}


else if(currentRole==="surveyor"){

title.innerText=
"Medical Surveyor Dashboard";

role.innerText=
"Medical Surveyor";

profile.innerText=
"Medical Surveyor";

risk.style.display="none";

riskNav.style.display="none";

editPatient.style.display=
"inline-block";

editParameters.style.display=
"inline-block";


access.innerHTML=`

<strong style="color:var(--green)">
● Surveyor Access
</strong>

<br><br>

Patient details:
<strong>Editable</strong>

<br>

Biomedical parameters:
<strong>Editable</strong>

<br>

Medical reports:
<strong>Editable</strong>

<br>

Risk score:
<strong>Restricted</strong>

`;

}


else{

title.innerText=
"My Health Dashboard";

role.innerText=
"Patient";

profile.innerText=
name;

risk.style.display="none";

riskNav.style.display="none";

editPatient.style.display=
"none";

editParameters.style.display=
"none";


access.innerHTML=`

<strong style="color:var(--green)">
● View Only
</strong>

<br><br>

Patient details:
<strong>View Only</strong>

<br>

Biomedical parameters:
<strong>View Only</strong>

<br>

Medical reports:
<strong>View Only</strong>

<br>

Risk score:
<strong>Not Available</strong>

`;

}

}


/* =====================================================
                    NAVIGATION
===================================================== */

function showSection(section){

const sections={

patient:"patientSection",

parameters:"parametersSection",

reports:"reportsSection",

instruments:"instrumentsSection",

risk:"riskSection",

access:"accessSection"

};


if(section==="dashboard"){

window.scrollTo({
top:0,
behavior:"smooth"
});

return;

}


const element=
document.getElementById(
sections[section]
);


if(element){

element.scrollIntoView({
behavior:"smooth",
block:"start"
});

}

}


/* =====================================================
                PARAMETER INFORMATION
===================================================== */

function parameterInfo(name){

alert(
"📊 "+name+
"\n\nThis biomedical parameter is being monitored."
);

}


/* =====================================================
                INSTRUMENT INFORMATION
===================================================== */

function instrumentInfo(name){

alert(
"🏥 "+name+
"\n\nBiomedical instrument information."
);

}


/* =====================================================
                    REPORT
===================================================== */

function openReport(){

alert(
"📋 Medical Report\n\n"+
"Patient biomedical parameters are currently within the monitored range."
);

}


/* =====================================================
                PATIENT EDITOR
===================================================== */

function openPatientEditor(){

if(currentRole==="patient"){

alert(
"Patients have view-only access."
);

return;

}


document.getElementById(
"patientModal"
).style.display="flex";

}


function savePatient(){

const name=
document.getElementById(
"editName"
).value;


if(name){

document.getElementById(
"patientName"
).innerText=name;

}


closeModal(
"patientModal"
);


alert(
"Patient details updated successfully."
);

}


/* =====================================================
                PARAMETER EDITOR
===================================================== */

function openParameterEditor(){

if(currentRole==="patient"){

alert(
"Patients have view-only access."
);

return;

}


document.getElementById(
"parameterModal"
).style.display="flex";

}


function saveParameters(){

const temperature=
document.getElementById(
"editTemperature"
).value;

const spo2=
document.getElementById(
"editSpo2"
).value;

const heart=
document.getElementById(
"editHeart"
).value;

const glucose=
document.getElementById(
"editGlucose"
).value;

const weight=
document.getElementById(
"editWeight"
).value;

const bmi=
document.getElementById(
"editBmi"
).value;


document.getElementById(
"temperature"
).innerText=
temperature+"°C";


document.getElementById(
"spo2"
).innerText=
spo2+"%";


document.getElementById(
"heartRate"
).innerText=
heart+" BPM";


document.getElementById(
"glucose"
).innerText=
glucose+" mg/dL";


document.getElementById(
"weight"
).innerText=
weight+" kg";


document.getElementById(
"bmi"
).innerText=
bmi;


closeModal(
"parameterModal"
);


alert(
"Biomedical parameters updated successfully."
);

}


/* =====================================================
                    CLOSE MODAL
===================================================== */

function closeModal(id){

document.getElementById(id)
.style.display="none";

}


/* =====================================================
                    LOGOUT
===================================================== */

function logout(){

document.getElementById(
"dashboard"
).style.display="none";


document.getElementById(
"loginPage"
).style.display="flex";


document.getElementById(
"username"
).value="";


document.getElementById(
"password"
).value="";


document.getElementById(
"phone"
).value="";


currentRole="doctor";


const firstRole=
document.querySelector(".role");


selectRole(
"doctor",
firstRole
);

}

</script>

</body>

